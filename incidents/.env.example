# incidents/.env.example: template for the incident injector's PRODUCTION settings.
#
# Layered settings (tools/envconfig.py): real environment > this file > the root
# .env. LOCALLY YOU DON'T NEED THIS FILE: the root .env has everything (admin,
# app password, admin token, the vendor's parts) and the defaults are local.
#
# Two production copies, each with only what that place needs, both with
# LOAD_ROOT_ENV=false (a production run must never pick up the local root .env):
#   - prod-sql-01 (the VM):        incidents\.env, INJECTOR_HOST=vm
#                                  (SQL Server, API, and job incidents)
#   - your Mac, production vendor: incidents/.env.prod, run with
#                                  --env-file incidents/.env.prod, INJECTOR_HOST=mac
#                                  (the vendor incidents: Neon; its admin URL never leaves the Mac)

LOAD_ROOT_ENV=false

# local or prod
INJECTOR_ENVIRONMENT=prod
# prod only: vm or mac (which incidents this copy may run)
INJECTOR_HOST=

# -----------------------------------------------------------------------------
# SQL Server (the VM copy)
# -----------------------------------------------------------------------------
SQL_HOST=localhost
SQL_PORT=1433
SQL_TRUST_SERVER_CERTIFICATE=true
# The "admin" login incidents use. On the VM leave BOTH EMPTY: Windows
# authentication as the VM's administrator (a plausible human DBA session).
# (Locally they come from the root .env: SQL_ADMIN_USER and SA_PASSWORD.)
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# The ShopLite API (the VM copy)
# -----------------------------------------------------------------------------
# Its .env: incidents that imitate the app read shoplite_app's password from it
# (DB_PASSWORD), and the API-fault incident edits FEATURE_FLAGS in it.
API_ENV_FILE=C:\atlas\shoplite\api\.env
# How to restart the API after that edit. (Locally, unset: the injector asks
# you to restart your local uvicorn.)
API_RESTART_COMMAND=powershell -NoProfile -ExecutionPolicy Bypass -File C:\atlas\shoplite\api\deploy\restart-api.ps1
# The API's address, for incidents that add load through it (plan regression,
# CPU credits). VM: http://127.0.0.1:8000 (straight to the API, not through
# Caddy). Mac production copy (the CPU incident, from outside like a real
# crawler): https://shoplite-aadarsh.northcentralus.cloudapp.azure.com
API_BASE_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# The vendor's Postgres, as its ADMIN (the Mac production copy only)
# -----------------------------------------------------------------------------
# Neon's owner URL (the same as VENDOR_ADMIN_URL in vendor/README.md). Never on
# the VM. (Locally it's built from the root .env's POSTGRES_* and VENDOR_*.)
VENDOR_ADMIN_URL=

# -----------------------------------------------------------------------------
# Ground truth (prod copies only): where the answer key goes
# -----------------------------------------------------------------------------
# The container URL of the GROUND-TRUTH storage account (its own account, NOT the
# backup account stshoplite...: Atlas may later read the backup account, and the
# answers must never be one role assignment away) WITH its write-only SAS
# (create + write; no read, no list), e.g.
#   https://<account>.blob.core.windows.net/incident-ground-truth?sp=cw&...&sig=...
# Setup: incidents/README.md, "The ground-truth storage account". Required in
# production: without it, no incident starts.
GROUND_TRUTH_SAS_URL=
# Local: ground truth goes to incidents/.ground-truth/ (git-ignored) unless set.
GROUND_TRUTH_DIR=
# Where the active incident's state is kept (default incidents/.state, git-ignored).
STATE_DIR=
