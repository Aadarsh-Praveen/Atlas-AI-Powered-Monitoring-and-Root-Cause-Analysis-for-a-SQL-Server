# .env.example: template for the root .env, the ONE settings file for local development.
#
# How to use:
#   1. Copy this file:   cp .env.example .env
#   2. Replace every "replace-me" in .env with a real value from your password
#      manager (each login gets its own password).
#   3. Never commit .env (.gitignore already blocks it). Only this template,
#      with placeholders, belongs in Git.
#
# Layered settings (tools/envconfig.py): every component reads
#   real environment variables  >  its own .env (e.g. server/etl/.env)  >  this root .env
# so locally you keep everything HERE, with one variable per login, and the
# components build their connection strings and URLs from these parts
# themselves (encoding special characters). A component's own .env is only
# needed on the VM, or to override one value locally. Which component uses
# which variable: README.md, "Settings: which component uses what".
#
# On prod-sql-01 (Phase 2+) the root .env is a separate file with only the
# admin values (SA_PASSWORD, SQL_ADMIN_USER, SHOPLITE_APP_PASSWORD), locked
# to Administrators; each service has its own locked .env with
# LOAD_ROOT_ENV=false, and never reads this one.
#
# Avoid these characters in passwords: $  #  "  '  `  ;  {  }  and spaces.
#   $ is treated as a variable by Docker Compose, # can start a comment, quotes
#   and spaces change how the value is parsed, ; { } break ODBC connection
#   strings. (@ and % are fine: components percent-encode passwords when they
#   build a URL. A URL you write by hand still needs them encoded.)
#   Safe symbols: !  _  -  .  +  %  ^  *  @

# =============================================================================
# SQL Server (container: shoplite-sql)
# =============================================================================
# Password for the built-in "sa" (system administrator) login.
#
# SQL Server enforces a complexity policy. The password must be at least
# 8 characters and contain characters from at least three of these four groups:
# uppercase letters, lowercase letters, digits, and symbols. Use all four to
# be safe, and make it long (16+ characters). The same rules apply to every
# SQL login password below.
#
# A weak SA_PASSWORD is the most common reason the shoplite-sql container
# starts and then exits. If that happens, run: docker compose logs shoplite-sql
# and look for a message about the password not meeting policy requirements.
SA_PASSWORD=replace-me

# Name of the SQL admin login that SA_PASSWORD belongs to. Optional: empty or
# missing means "sa", which is right for the local container. On prod-sql-01
# it's the SQL admin login named in Bicep (sqlAdminUsername), because Azure
# doesn't allow "sa" there; see server/vm-setup/README.md, step 6.
SQL_ADMIN_USER=sa

# Trust SQL Server's certificate without verifying it. true locally: the
# container's certificate is self-signed (the connection is still encrypted).
# The API, the ETL, the collector, and the injector all use this unless their
# own .env says otherwise (on the VM each one sets it explicitly).
SQL_TRUST_SERVER_CERTIFICATE=true

# -----------------------------------------------------------------------------
# One password per least-privilege SQL login. Each is created by its own
# script with this value, and each component falls back to it when its own
# variable isn't set (e.g. the API's DB_PASSWORD falls back to
# SHOPLITE_APP_PASSWORD). Changing one later means changing it in SQL Server
# too (re-run the login's script, or ALTER LOGIN).
# -----------------------------------------------------------------------------
# shoplite_app: the API (created by shoplite/db/apply_schema.py, 004).
SHOPLITE_APP_PASSWORD=replace-me
# shoplite_etl: the vendor ETL (server/etl/sql/002_etl_login.sql).
SHOPLITE_ETL_PASSWORD=replace-me
# shoplite_monitor: the monitoring collector (server/collector/sql/001_monitor_login.sql).
SHOPLITE_MONITOR_PASSWORD=replace-me

# =============================================================================
# Postgres (container: vendor-pg), the local stand-in for the vendor database
# =============================================================================
# The vendor's ADMIN (database owner). These create the user and database the
# first time the container starts with an empty volume; changing them later
# has no effect unless you delete the volume (docker compose down -v, which
# erases data).
POSTGRES_USER=vendor
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=vendordb

# The vendor's two other roles (vendor/sql/001_schema.sql creates them):
# shoplite_reader: read-only, used by the ETL and the collector's vendor check.
SHOPLITE_READER_PASSWORD=replace-me
# vendor_activity: the vendor's daily changes (vendor/activity.py).
VENDOR_ACTIVITY_PASSWORD=replace-me

# Where the vendor's Postgres is, for URLs built from the parts above.
# Locally the container on 5433 (a Mac-installed Postgres usually owns 5432).
VENDOR_HOST=localhost
VENDOR_PORT=5433

# =============================================================================
# The ShopLite API (local)
# =============================================================================
# Shared token for the admin endpoints (demo only, not real authentication).
# Used by the API itself (ADMIN_TOKEN) and, through the fallback, by the
# shoppers, Locust (SHOPLITE_ADMIN_TOKEN), and the incident injector.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=replace-me

# Where the local storefront and API run (the shoppers and Locust use these).
STOREFRONT_URL=http://localhost:3000
API_URL=http://localhost:8000
