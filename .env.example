# .env.example: template for the root .env file (local development only).
#
# How to use:
#   1. Copy this file:   cp .env.example .env
#   2. Replace every "replace-me" in .env with a real password from your
#      password manager.
#   3. Never commit .env (.gitignore already blocks it). Only this template,
#      with placeholders, belongs in Git.
#
# Read by:
#   - docker-compose.yml   to create the database containers
#   - tools/check_local.py to connect to them from Python
#   - shoplite/db/apply_schema.py and seed.py to build and fill SalesDB
#
# On prod-sql-01 (Phase 2) the root .env is a separate, new file with new
# passwords and only the database settings; see server/vm-setup/README.md.
#
# Avoid these characters in passwords: $  #  "  '  `  ;  {  }  @  and spaces.
#   $ is treated as a variable by Docker Compose, # can start a comment, quotes
#   and spaces change how the value is parsed, ; { } break ODBC connection
#   strings, and @ breaks database URLs used in later phases.
#   Safe symbols: !  _  -  .  +  %  ^  *

# -----------------------------------------------------------------------------
# SQL Server (container: shoplite-sql)
# Password for the built-in "sa" (system administrator) login.
#
# SQL Server enforces a complexity policy. The password must be at least
# 8 characters and contain characters from at least three of these four groups:
# uppercase letters, lowercase letters, digits, and symbols. Use all four to
# be safe, and make it long (16+ characters).
#
# A weak SA_PASSWORD is the most common reason the shoplite-sql container
# starts and then exits. If that happens, run: docker compose logs shoplite-sql
# and look for a message about the password not meeting policy requirements.
# -----------------------------------------------------------------------------
SA_PASSWORD=replace-me

# Name of the SQL admin login that SA_PASSWORD belongs to. Read by
# shoplite/db/apply_schema.py and seed.py. Optional: if it's missing or empty
# they use "sa", which is right for the local container, so locally you can
# leave it as is. On prod-sql-01 it must be the SQL admin login you named in
# Bicep (sqlAdminUsername), because Azure doesn't allow "sa" there; see
# server/vm-setup/README.md, step 6.
SQL_ADMIN_USER=sa

# -----------------------------------------------------------------------------
# ShopLite application login (created in SalesDB by apply_schema.py, 004)
# The least-privilege login the API uses. Set the API's DB_PASSWORD
# (shoplite/api/.env) to the same value. Same password rules as SA_PASSWORD.
# -----------------------------------------------------------------------------
SHOPLITE_APP_PASSWORD=replace-me

# -----------------------------------------------------------------------------
# Postgres (container: vendor-pg), the local stand-in for the vendor database.
# These are used only the first time the container starts with an empty
# volume, to create this user and database. Changing them later has no effect
# unless you delete the volume (docker compose down -v, which erases data).
# -----------------------------------------------------------------------------
POSTGRES_USER=vendor
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=vendordb
