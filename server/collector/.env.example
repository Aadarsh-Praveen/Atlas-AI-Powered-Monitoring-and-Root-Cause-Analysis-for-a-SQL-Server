# server/collector/.env.example: template for the monitoring collector's
# settings on the VM (C:\atlas\server\collector\.env), readable only by
# Administrators, SYSTEM, and the service account (README.md, "On prod-sql-01").
#
# Layered settings (tools/envconfig.py): real environment > THIS file > the
# root .env. LOCALLY YOU DON'T NEED THIS FILE: the root .env has everything
# (one variable per login; see the root .env.example and README.md). Create
# it locally only to override a value, with just that line in it.
#
# ON THE VM it's the service's only settings file: keep LOAD_ROOT_ENV=false,
# so the root .env (admin passwords, Administrators only) is never read, even
# when you run this by hand as Administrator.
#
# Read by main.py at startup; a missing or inconsistent value stops it with
# exit code 2. Locally the root .env supplies SHOPLITE_MONITOR_PASSWORD and the
# vendor URL's parts; the local XE path is the default; destinations stay empty
# (run with --print).

LOAD_ROOT_ENV=false

# -----------------------------------------------------------------------------
# SQL Server, as the read-only shoplite_monitor login (never sa)
# -----------------------------------------------------------------------------
SQL_HOST=localhost
SQL_PORT=1433
SQL_USER=shoplite_monitor
# MUST BE IDENTICAL to the SHOPLITE_MONITOR_PASSWORD you passed to
# sql/001_monitor_login.sql. A mismatch: the heartbeat shows SqlOk=false and
# LastError "Login failed for user 'shoplite_monitor'".
SQL_PASSWORD=replace-me
# true locally and on the VM (SQL Server's self-signed certificate; the
# connection never leaves the machine), as for the API and the ETL.
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_CONNECT_TIMEOUT_SECONDS=10
# Monitoring must stay light: any single query is cancelled after this long.
SQL_QUERY_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# What to read
# -----------------------------------------------------------------------------
# The Extended Events files, as SQL Server sees them (SQL Server reads them).
#   Production: F:\XE\ShopLite_Diagnostics*.xel
#   Local:      /var/opt/mssql/xe/ShopLite_Diagnostics*.xel
XE_FILE_PATTERN=F:\XE\ShopLite_Diagnostics*.xel

# Optional: the vendor check (VendorFeed_CL), as the READ-ONLY shoplite_reader,
# the same URL as the ETL's VENDOR_READER_URL. Empty = no vendor check.
#   Local:      postgresql://shoplite_reader:<password>@localhost:5433/vendordb
#   Production: postgresql://shoplite_reader:<password>@<neon host>/<database>?sslmode=require
# (Percent-encode the password if it has symbols other than - _ . ~ : see vendor/README.md.)
VENDOR_READER_URL=

# -----------------------------------------------------------------------------
# Where the collector keeps its state and buffer
# -----------------------------------------------------------------------------
# Production: F:\collector (on the data disk). Local default: server/collector/.data
COLLECTOR_DATA_DIR=F:\collector
# A destination's buffer is capped at this size; the oldest unsent files go first.
BUFFER_MAX_MB=500

# -----------------------------------------------------------------------------
# Destination 1: Log Analytics (Logs Ingestion API). Leave empty locally.
# All three come from observability/azure-setup.md (B3). Sign-in is the VM's
# managed identity: no secret here.
# -----------------------------------------------------------------------------
# The data collection endpoint's "Logs ingestion" URL, e.g.
# https://dce-shoplite-xxxx.northcentralus-1.ingest.monitor.azure.com
LA_DCE_ENDPOINT=
# The two data collection rules' Immutable IDs (dcr-0123...), from each rule's JSON view.
LA_DCR_SQL_IMMUTABLE_ID=
LA_DCR_OPS_IMMUTABLE_ID=
# Only if you use a user-assigned identity instead of the VM's system-assigned one.
MANAGED_IDENTITY_CLIENT_ID=

# -----------------------------------------------------------------------------
# Destination 2: ADX, the free cluster (history). Leave empty locally.
# The free cluster doesn't support managed identities, so the collector signs
# in as an app registration; its secret is the ONE secret in this file.
# -----------------------------------------------------------------------------
# The cluster's DATA INGESTION URI (not the query URI), from the cluster's
# overview page, e.g. https://ingest-kvc-xxxx.northeurope.kusto.windows.net
ADX_INGEST_URI=
ADX_DATABASE=shoplite
ADX_TENANT_ID=
ADX_APP_ID=
ADX_APP_SECRET=replace-me
