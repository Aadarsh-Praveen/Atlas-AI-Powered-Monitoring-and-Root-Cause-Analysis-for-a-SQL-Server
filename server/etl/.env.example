# server/etl/.env.example: template for the vendor ETL's settings (server/etl/.env).
#
# How to use:
#   cp server/etl/.env.example server/etl/.env
#   then replace every "replace-me". Never commit .env (.gitignore blocks it).
#
# Read by run_etl.py at the start of each run (variables already set in the
# environment win). A missing or invalid value stops the run with exit code 2
# before anything connects.
#
# One file per machine: on your Mac it points at the local Docker databases;
# on prod-sql-01 it's a separate file with the production values (Neon, and
# SQL Server on the VM itself), readable only by the SQL Agent service
# account and administrators (see README.md, "On prod-sql-01").
#
# Passwords: letters, digits, and only - _ . ~ (the vendor password sits
# inside a URL, where other symbols need escaping).

# -----------------------------------------------------------------------------
# The vendor (Postgres), as the READ-ONLY login shoplite_reader
# -----------------------------------------------------------------------------
# The ETL refuses any other login, and refuses a non-local host without
# sslmode=require (the data contract requires TLS).
#
# This is a whole URL, used as written, so a password with anything other
# than letters, digits, - _ . ~ must be percent-encoded in it (@ -> %40,
# # -> %23, % -> %25, / -> %2F, : -> %3A). To encode one without it landing
# in your shell history (it prints the encoded form to paste here):
#   python3 -c "import getpass, urllib.parse; print(urllib.parse.quote(getpass.getpass(), safe=''))"
#
# Local (vendor-pg container):
#   postgresql://shoplite_reader:<password>@localhost:5433/vendordb
# Production (Neon, the DIRECT host, not the "-pooler" one):
#   postgresql://shoplite_reader:<password>@<neon host>/<database>?sslmode=require
VENDOR_READER_URL=postgresql://shoplite_reader:replace-me@localhost:5433/vendordb

# Give up connecting after this long. Neon's free tier may take a few
# seconds to wake up, so don't go much lower than 15.
VENDOR_CONNECT_TIMEOUT_SECONDS=15
# Cancel any single vendor query after this long.
VENDOR_STATEMENT_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# SalesDB, as the least-privilege login shoplite_etl (never sa)
# -----------------------------------------------------------------------------
# localhost in both places: locally the Docker container, on prod-sql-01 the
# ETL runs on the VM itself.
SALESDB_HOST=localhost
SALESDB_PORT=1433
SALESDB_NAME=SalesDB
SALESDB_USER=shoplite_etl
# MUST BE IDENTICAL to the SHOPLITE_ETL_PASSWORD you passed to
# server/etl/sql/002_etl_login.sql. A mismatch gives
# "Login failed for user 'shoplite_etl'. (18456)" and exit code 3.
SALESDB_PASSWORD=replace-me

# Connections are always encrypted. This only controls whether the server's
# certificate is trusted without verification: true locally (self-signed
# container certificate) and on prod-sql-01 too, the same value as the API's
# DB_TRUST_SERVER_CERTIFICATE there (SQL Server's own self-signed
# certificate, connection never leaves the VM).
SALESDB_TRUST_SERVER_CERTIFICATE=true

# Give up connecting after this long.
SALESDB_CONNECT_TIMEOUT_SECONDS=10
# Cancel any single SalesDB statement (staging, merge) after this long.
SALESDB_QUERY_TIMEOUT_SECONDS=300
