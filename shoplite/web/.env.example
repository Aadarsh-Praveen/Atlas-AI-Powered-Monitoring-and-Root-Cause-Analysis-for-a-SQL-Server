# shoplite/web/.env.example: template for shoplite/web/.env.local
#
# How to use:
#   cp shoplite/web/.env.example shoplite/web/.env.local
# .env.local is ignored by Git (see the root .gitignore).
#
# WARNING: variables starting with NEXT_PUBLIC_ are built into the JavaScript
# that every visitor's browser downloads. Anyone can read them. Never put a
# secret here (no passwords, no admin token, no API keys).

# Where the browser sends API requests. Locally, the FastAPI server from
# shoplite/api. In Phase 2 this becomes the production API's HTTPS address,
# set in Vercel's project settings, so the same code works in both places.
# No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000
