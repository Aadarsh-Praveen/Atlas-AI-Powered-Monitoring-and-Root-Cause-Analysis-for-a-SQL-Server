# shoplite/api/.env.example: OPTIONAL local overrides for the API (shoplite/api/.env).
#
# Layered settings (tools/envconfig.py): real environment > shoplite/api/.env
# > the root .env. LOCALLY YOU DON'T NEED THIS FILE: the root .env has the two
# required values (SHOPLITE_APP_PASSWORD, used as DB_PASSWORD, and ADMIN_TOKEN),
# and every other setting has a working default. Create shoplite/api/.env only
# to change a setting below, with just those lines in it.
#
# On the VM the API uses its own file from deploy/.env.production.example
# instead (with LOAD_ROOT_ENV=false).
#
# Read and validated by app/config.py at startup. A missing or invalid value
# stops the API with a clear error instead of failing on the first request.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Sent in the X-App-Version response header and in the SQL Server session tag
# (ShopLite-API/<version>), so Atlas can tell which release a session came from.
APP_VERSION=1.0.0

# DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database (SalesDB as the least-privilege shoplite_app login, never sa)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=1433
DB_NAME=SalesDB
DB_USER=shoplite_app
# MUST BE IDENTICAL to SHOPLITE_APP_PASSWORD in the root .env: apply_schema.py
# created the shoplite_app login with that value. A mismatch gives
# "Login failed for user 'shoplite_app'. (18456)" and /health returns 503.
# DB_PASSWORD=          (locally: the root .env's SHOPLITE_APP_PASSWORD)

# Connections are always encrypted (ODBC Driver 18). This only controls
# whether the server's certificate is trusted without verification:
# true locally (the container's certificate is self-signed). Phase 2 decides
# the production value.
DB_TRUST_SERVER_CERTIFICATE=true

# Give up connecting after this long (container down, wrong host).
DB_CONNECT_TIMEOUT_SECONDS=5
# Cancel any single query after this long, so a blocked query returns a 503
# instead of hanging the request forever. Long enough for the admin reports
# over a two-year range under Rosetta.
DB_QUERY_TIMEOUT_SECONDS=30

# Connection pool: connections kept open and reused across requests.
# POOL_SIZE stay open; up to MAX_OVERFLOW extra are opened under load.
# A request waits up to POOL_TIMEOUT for a free connection, then fails (503).
# Connections are replaced after RECYCLE seconds to avoid stale ones.
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# -----------------------------------------------------------------------------
# Web
# -----------------------------------------------------------------------------
# Browser origins allowed to call the API (CORS), comma-separated.
# Locally the storefront; the Vercel domain is added in Phase 2.
ALLOWED_ORIGINS=http://localhost:3000

# Shared token for the admin endpoints (demo only, not real authentication).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=          (locally: the root .env's ADMIN_TOKEN)

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# Comma-separated names of flags to turn ON. Empty means everything is off
# (the normal state). Unknown names are rejected at startup, so a typo can't
# silently do nothing. Known flags (app/flags.py):
#   search_ranking_v2   product search in relevance order via the ranking
#                       service (app/ranking.py): the Phase 5 "API fault"
#                       incident; the incident injector turns it on and off
FEATURE_FLAGS=

# The (simulated) ranking service, used only while search_ranking_v2 is on:
# each call takes this long, and fails this share of the time (0.5 = half).
RANKING_SERVICE_DELAY_MS=2500
RANKING_SERVICE_ERROR_RATE=0.5

# -----------------------------------------------------------------------------
# Simulated payment provider (called after the checkout transaction commits)
# -----------------------------------------------------------------------------
# Chance a payment is declined (0.02 = about 1 in 50).
PAYMENT_DECLINE_RATE=0.02
# The provider "takes" a random time in this range, in milliseconds.
PAYMENT_DELAY_MIN_MS=200
PAYMENT_DELAY_MAX_MS=800

# -----------------------------------------------------------------------------
# Telemetry: Application Insights (Phase 5, API 1.2.0)
# -----------------------------------------------------------------------------
# Leave EMPTY locally: telemetry is then off and nothing is sent anywhere.
# Production: the connection string of appi-shoplite-prod
# (observability/azure-setup.md, step 2).
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Share of requests kept, each with all its SQL calls (0.25 = one in four).
TELEMETRY_SAMPLING_RATIO=0.25
