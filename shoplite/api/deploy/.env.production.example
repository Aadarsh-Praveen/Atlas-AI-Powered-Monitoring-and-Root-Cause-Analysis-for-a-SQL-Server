# shoplite/api/deploy/.env.production.example: template for the API's
# settings ON prod-sql-01.
#
# How to use (on the VM; see shoplite/api/deploy/README.md):
#   Copy-Item C:\atlas\shoplite\api\deploy\.env.production.example C:\atlas\shoplite\api\.env
#   notepad C:\atlas\shoplite\api\.env
# The API always reads shoplite\api\.env; this file is only the template.
# After any edit, restart with restart-api.ps1 (not just Restart-Service).
#
# Layout: every setting is a line WITHOUT "#" in front. Comments never contain
# a "NAME=value" line, so the line you edit is always the real one. Only the
# four settings in "1. EDIT THESE" need changing.
#
# Avoid these characters in secrets: $ # " ' ` ; { } @ and spaces.

# The API's ONLY settings file on the VM: never read the root .env (admin
# passwords, Administrators only), even when started by hand as Administrator.
# (tools/envconfig.py, layered settings.)
LOAD_ROOT_ENV=false

# =============================================================================
# 1. EDIT THESE (four settings)
# =============================================================================

# Password of the shoplite_app SQL login.
# MUST BE IDENTICAL to SHOPLITE_APP_PASSWORD in the VM's root .env
# (C:\atlas\.env): apply_schema.py created the login with that value. If they
# differ, every request fails with
#   Login failed for user 'shoplite_app'. (18456)
# in the API log and SQL Server's error log, and /health returns 503.
DB_PASSWORD=replace-me

# A NEW admin token for the storefront's admin pages (not your local one).
# Generate it on the VM with:
#   C:\atlas\shoplite\api\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it in your password manager.
ADMIN_TOKEN=replace-me

# The storefront's production origin: https, exact, no trailing slash. This is
# production's real value. Only this domain may call the API from a browser;
# Vercel preview and branch URLs (the ones with -git- in them) are blocked on
# purpose. To allow several, separate them with commas on this one line.
ALLOWED_ORIGINS=https://shoplite-aadarsh.vercel.app

# Phase 5 (API 1.2.0): Application Insights connection string of
# appi-shoplite-prod (portal: the resource's Overview -> Connection string;
# observability/azure-setup.md, step 2). It lets anyone who has it send data
# into the resource, so keep it in your password manager like a secret.
APPLICATIONINSIGHTS_CONNECTION_STRING=replace-me

# =============================================================================
# 2. Normally left as they are
# =============================================================================

# Set by deploy.ps1 -Version X.Y.Z on every deploy. Shows in /health, the
# X-App-Version header, and the SQL Server session tag ShopLite-API/<version>.
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# SQL Server on THIS VM, as the least-privilege shoplite_app login.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=SalesDB
DB_USER=shoplite_app

# Deliberate, documented decision: trust the server certificate without
# verifying it. The connection is still encrypted (ODBC Driver 18 always
# encrypts); only the certificate check is skipped. Safe here because the API
# and SQL Server are on the same machine: the traffic goes over localhost and
# never leaves the VM. For a database on another server, install a proper
# certificate on SQL Server and set this to false.
DB_TRUST_SERVER_CERTIFICATE=true

DB_CONNECT_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_SECONDS=30

# The service runs ONE Uvicorn process (shoplite-api.xml), so the API holds at
# most 10 + 5 = 15 connections to SQL Server.
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# Feature flags: all off normally. search_ranking_v2 (Phase 5) is the
# "API fault" incident; the incident injector turns it on and off.
FEATURE_FLAGS=

# The (simulated) ranking service behind search_ranking_v2: only used while
# that flag is on. The incident injector may change these for an incident.
RANKING_SERVICE_DELAY_MS=2500
RANKING_SERVICE_ERROR_RATE=0.5

# Share of requests sent to Application Insights, each with its SQL calls.
TELEMETRY_SAMPLING_RATIO=0.25

# Simulated payment provider.
PAYMENT_DECLINE_RATE=0.02
PAYMENT_DELAY_MIN_MS=200
PAYMENT_DELAY_MAX_MS=800
