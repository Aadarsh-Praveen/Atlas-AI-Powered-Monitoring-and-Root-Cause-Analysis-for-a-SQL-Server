# shoplite/api/deploy/.env.production.example: template for the API's
# settings ON prod-sql-01.
#
# How to use (on the VM; see shoplite/api/deploy/README.md):
#   Copy-Item C:\atlas\shoplite\api\deploy\.env.production.example C:\atlas\shoplite\api\.env
#   notepad C:\atlas\shoplite\api\.env
# The API always reads shoplite\api\.env; this file is only the template.
# Replace every "replace-me". Never commit the real file (.gitignore blocks it).
#
# Production differs from local development (shoplite/api/.env.example) in:
#   NEW secrets      DB_PASSWORD and ADMIN_TOKEN are new values, never the Mac's.
#   ALLOWED_ORIGINS  the Vercel production domain only.
#   APP_VERSION      set by deploy.ps1 on every deploy.
# Everything else keeps the same meaning; see shoplite/api/.env.example.
#
# Same safe characters as the root .env.example: avoid $ # " ' ` ; { } @ and
# spaces in secrets.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Written by deploy.ps1 -Version X.Y.Z. Shows in /health, the X-App-Version
# header, and the SQL Server session tag ShopLite-API/<version>.
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database: SQL Server on THIS VM, as the least-privilege shoplite_app login
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=1433
DB_NAME=SalesDB
DB_USER=shoplite_app
# The SHOPLITE_APP_PASSWORD from the VM's root .env (C:\atlas\.env), the value
# apply_schema.py created the login with. NOT your local password.
DB_PASSWORD=replace-me

# Deliberate, documented decision: trust the server certificate without
# verifying it. The connection is still encrypted (ODBC Driver 18 always
# encrypts); only the certificate check is skipped. Safe here because the API
# and SQL Server are on the same machine: the traffic goes over localhost and
# never leaves the VM, so there's no network for anyone to intercept. For a
# database on a different server, install a proper certificate on SQL Server
# and set this to false.
DB_TRUST_SERVER_CERTIFICATE=true

DB_CONNECT_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_SECONDS=30

# Per Uvicorn worker. The service runs 2 workers (shoplite-api.xml), so the
# API can hold up to 2 x (10 + 5) = 30 connections to SQL Server.
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# -----------------------------------------------------------------------------
# Web
# -----------------------------------------------------------------------------
# The Vercel PRODUCTION domain only: https, exact, no trailing slash, e.g.
#   ALLOWED_ORIGINS=https://shoplite-xyz.vercel.app
# Vercel preview deployments get other URLs and are blocked by CORS on
# purpose. Until Vercel exists, leave the placeholder; after the first Vercel
# deploy, put the real domain here and restart the service (README.md).
ALLOWED_ORIGINS=https://replace-me.vercel.app

# A NEW token, different from your local one. Generate it on the VM:
#   C:\atlas\shoplite\api\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
# Store it in your password manager; you type it into the storefront's admin page.
ADMIN_TOKEN=replace-me

# -----------------------------------------------------------------------------
# Feature flags (all off in Phase 2)
# -----------------------------------------------------------------------------
FEATURE_FLAGS=

# -----------------------------------------------------------------------------
# Simulated payment provider
# -----------------------------------------------------------------------------
PAYMENT_DECLINE_RATE=0.02
PAYMENT_DELAY_MIN_MS=200
PAYMENT_DELAY_MAX_MS=800
