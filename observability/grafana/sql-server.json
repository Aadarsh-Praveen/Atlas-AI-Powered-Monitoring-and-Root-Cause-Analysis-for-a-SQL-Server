{
  "uid": "shoplite-sql-server",
  "title": "ShopLite: SQL Server",
  "description": "SQL Server internals over time (ADX history): waits, workload, sessions, blocking, deadlocks, top queries, logs, and file I/O.",
  "tags": [
    "shoplite",
    "phase5"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "adx",
        "label": "History (ADX)",
        "type": "datasource",
        "query": "grafana-azure-data-explorer-datasource",
        "hide": 0
      },
      {
        "name": "azmon",
        "label": "Now (Azure Monitor)",
        "type": "datasource",
        "query": "grafana-azure-monitor-datasource",
        "hide": 0
      },
      {
        "name": "workspace",
        "label": "Log Analytics workspace resource ID",
        "type": "textbox",
        "hide": 0,
        "query": "/subscriptions/<subscription-id>/resourceGroups/rg-shoplite-prod/providers/Microsoft.OperationalInsights/workspaces/law-shoplite-prod",
        "current": {
          "text": "/subscriptions/<subscription-id>/resourceGroups/rg-shoplite-prod/providers/Microsoft.OperationalInsights/workspaces/law-shoplite-prod",
          "value": "/subscriptions/<subscription-id>/resourceGroups/rg-shoplite-prod/providers/Microsoft.OperationalInsights/workspaces/law-shoplite-prod"
        }
      },
      {
        "name": "subscription",
        "label": "Subscription ID",
        "type": "textbox",
        "hide": 0,
        "query": "<subscription-id>",
        "current": {
          "text": "<subscription-id>",
          "value": "<subscription-id>"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Waits by type (seconds per interval, top 8)",
      "description": "The best starting point for 'why is it slow?': LCK_* = blocking, PAGEIOLATCH_* = disk reads, SOS_SCHEDULER_YIELD = CPU, WRITELOG = log writes.",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${adx}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${adx}"
          },
          "database": "shoplite",
          "queryType": "KQL",
          "rawMode": true,
          "query": "let top = SqlWaitStats_CL | where $__timeFilter(TimeGenerated)\n                | summarize Total = sum(WaitTimeMs) by WaitType | top 8 by Total | project WaitType;\n            SqlWaitStats_CL | where $__timeFilter(TimeGenerated) and WaitType in (top)\n            | summarize WaitSeconds = sum(WaitTimeMs) / 1000.0 by bin(TimeGenerated, $__timeInterval), WaitType\n            | order by TimeGenerated asc",
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Workload (per second)",
      "description": "",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${adx}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${adx}"
          },
          "database": "shoplite",
          "queryType": "KQL",
          "rawMode": true,
          "query": "SqlPerfCounters_CL | where $__timeFilter(TimeGenerated)\n            | where CounterName in (\"Batch Requests/sec\", \"SQL Compilations/sec\", \"SQL Re-Compilations/sec\")\n            | summarize Value = avg(Value) by bin(TimeGenerated, $__timeInterval), CounterName\n            | order by TimeGenerated asc",
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Memory: page life expectancy and grants pending",
      "description": "",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${adx}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${adx}"
          },
          "database": "shoplite",
          "queryType": "KQL",
          "rawMode": true,
          "query": "SqlPerfCounters_CL | where $__timeFilter(TimeGenerated)\n            | where CounterName in (\"Page life expectancy\", \"Memory Grants Pending\")\n            | summarize Value = avg(Value) by bin(TimeGenerated, $__timeInterval), CounterName\n            | order by TimeGenerated asc",
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Sessions by program",
      "description": "",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${adx}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${adx}"
          },
          "database": "shoplite",
          "queryType": "KQL",
          "rawMode": true,
          "query": "SqlSessions_CL | where $__timeFilter(TimeGenerated)\n            | summarize Sessions = max(Sessions) by bin(TimeGenerated, $__timeInterval), ProgramName\n            | order by TimeGenerated asc",
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Blocked sessions and deadlocks",
      "description": "",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${adx}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${adx}"
          },
          "database": "shoplite",
          "queryType": "KQL",
          "rawMode": true,
          "query": "union\n              (SqlBlocking_CL | where $__timeFilter(TimeGenerated) and Role == \"blocked\"\n               | summarize Value = dcount(SessionId) by bin(TimeGenerated, $__timeInterval) | extend Series = \"blocked sessions\"),\n              (SqlXEvents_CL | where $__timeFilter(TimeGenerated) and EventName == \"xml_deadlock_report\"\n               | summarize Value = dcount(EventId) by bin(TimeGenerated, $__timeInterval) | extend Series = \"deadlocks\")\n            | order by TimeGenerated asc",
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Head blockers in the time range",
      "description": "",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${adx}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${adx}"
          },
          "database": "shoplite",
          "queryType": "KQL",
          "rawMode": true,
          "query": "SqlBlocking_CL | where $__timeFilter(TimeGenerated) and Role == \"head_blocker\"\n            | summarize FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated),\n                        LongestTransactionSeconds = max(TransactionSeconds),\n                        arg_max(TimeGenerated, ProgramName, LoginName, HostName, SessionStatus, StatementText)\n                by SessionId\n            | order by LastSeen desc",
          "resultFormat": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Top queries in the time range (Query Store, by total duration)",
      "description": "Plans above 1 = the query ran with more than one plan: a possible plan regression. ForcedPlan 1 = a plan is forced in Query Store: the usual suspect when it's slow.",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${adx}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${adx}"
          },
          "database": "shoplite",
          "queryType": "KQL",
          "rawMode": true,
          "query": "SqlTopQueries_CL | where $__timeFilter(TimeGenerated)\n            | summarize arg_max(TimeGenerated, *) by EventId\n            | summarize Executions = sum(Executions), TotalSeconds = round(sum(TotalDurationMs) / 1000, 1),\n                        AvgMs = round(sum(TotalDurationMs) / sum(Executions), 1), MaxMs = max(MaxDurationMs),\n                        Plans = dcount(PlanHash), ForcedPlan = max(toint(IsForcedPlan)),\n                        QueryText = take_any(QueryText)\n                by DatabaseName, QueryHash\n            | top 20 by TotalSeconds desc",
          "resultFormat": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Transaction log used (%) by database",
      "description": "The log-full alert fires above 70%.",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${adx}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${adx}"
          },
          "database": "shoplite",
          "queryType": "KQL",
          "rawMode": true,
          "query": "SqlDatabases_CL | where $__timeFilter(TimeGenerated) and isnotnull(LogUsedPercent)\n            | summarize LogUsedPercent = max(LogUsedPercent) by bin(TimeGenerated, $__timeInterval), DatabaseName\n            | order by TimeGenerated asc",
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Average read and write latency by database file",
      "description": "",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${adx}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${adx}"
          },
          "database": "shoplite",
          "queryType": "KQL",
          "rawMode": true,
          "query": "SqlFileIo_CL | where $__timeFilter(TimeGenerated)\n            | summarize ReadMs = sum(ReadStallMs) * 1.0 / iff(sum(Reads) == 0, 1, sum(Reads)),\n                        WriteMs = sum(WriteStallMs) * 1.0 / iff(sum(Writes) == 0, 1, sum(Writes))\n                by bin(TimeGenerated, $__timeInterval), File = strcat(DatabaseName, \" \", FileType)\n            | order by TimeGenerated asc",
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Database data size (MB)",
      "description": "",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${adx}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${adx}"
          },
          "database": "shoplite",
          "queryType": "KQL",
          "rawMode": true,
          "query": "SqlDatabases_CL | where $__timeFilter(TimeGenerated) and isnotnull(DataSizeMB)\n            | summarize DataSizeMB = max(DataSizeMB) by bin(TimeGenerated, 1h), DatabaseName\n            | order by TimeGenerated asc",
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 8
      }
    }
  ]
}
