{
  "uid": "shoplite-overview",
  "title": "ShopLite: Overview",
  "description": "Is ShopLite healthy right now? The one dashboard to open first.",
  "tags": [
    "shoplite",
    "phase5"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "adx",
        "label": "History (ADX)",
        "type": "datasource",
        "query": "grafana-azure-data-explorer-datasource",
        "hide": 0
      },
      {
        "name": "azmon",
        "label": "Now (Azure Monitor)",
        "type": "datasource",
        "query": "grafana-azure-monitor-datasource",
        "hide": 0
      },
      {
        "name": "workspace",
        "label": "Log Analytics workspace resource ID",
        "type": "textbox",
        "hide": 0,
        "query": "/subscriptions/<subscription-id>/resourceGroups/rg-shoplite-prod/providers/Microsoft.OperationalInsights/workspaces/law-shoplite-prod",
        "current": {
          "text": "/subscriptions/<subscription-id>/resourceGroups/rg-shoplite-prod/providers/Microsoft.OperationalInsights/workspaces/law-shoplite-prod",
          "value": "/subscriptions/<subscription-id>/resourceGroups/rg-shoplite-prod/providers/Microsoft.OperationalInsights/workspaces/law-shoplite-prod"
        }
      },
      {
        "name": "subscription",
        "label": "Subscription ID",
        "type": "textbox",
        "hide": 0,
        "query": "<subscription-id>",
        "current": {
          "text": "<subscription-id>",
          "value": "<subscription-id>"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Collector: minutes since last heartbeat",
      "description": "Over 5 = the heartbeat alert fires (business hours).",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${azmon}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${azmon}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "CollectorHeartbeat_CL | summarize Last = max(TimeGenerated)\n            | project Minutes = datetime_diff('minute', now(), Last)",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "API requests (last 15 min)",
      "description": "",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${azmon}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${azmon}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppRequests | where TimeGenerated > ago(15m) | summarize Requests = sum(ItemCount)",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      },
      "id": 2,
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "API 5xx % (last 15 min)",
      "description": "",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${azmon}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${azmon}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppRequests | where TimeGenerated > ago(15m)\n            | summarize Errors = sumif(ItemCount, ResultCode startswith \"5\"), Requests = sum(ItemCount)\n            | project ErrorPercent = iff(Requests == 0, 0.0, 100.0 * Errors / Requests)",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      },
      "id": 3,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "API p95 (last 15 min)",
      "description": "",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${azmon}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${azmon}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppRequests | where TimeGenerated > ago(15m) | summarize P95 = percentile(DurationMs, 95)",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1500
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Blocked sessions (last 5 min)",
      "description": "",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${azmon}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${azmon}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "SqlBlocking_CL | where TimeGenerated > ago(5m) and Role == \"blocked\"\n            | summarize Blocked = dcount(SessionId)",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      },
      "id": 5,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "SalesDB: minutes since log backup",
      "description": "",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${azmon}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${azmon}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "SqlDatabases_CL | where DatabaseName == \"SalesDB\" | summarize arg_max(TimeGenerated, LastLogBackupAt)\n            | project Minutes = datetime_diff('minute', now(), LastLogBackupAt)",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      },
      "id": 6,
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "API requests per minute, and server errors",
      "description": "",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${azmon}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${azmon}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppRequests | where $__timeFilter(TimeGenerated)\n            | summarize Requests = sum(ItemCount), ServerErrors = sumif(ItemCount, ResultCode startswith \"5\")\n                by bin(TimeGenerated, 1m)",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "SQL Server batch requests per second",
      "description": "",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${adx}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${adx}"
          },
          "database": "shoplite",
          "queryType": "KQL",
          "rawMode": true,
          "query": "SqlPerfCounters_CL | where $__timeFilter(TimeGenerated) and CounterName == \"Batch Requests/sec\"\n            | summarize BatchRequestsPerSec = avg(Value) by bin(TimeGenerated, $__timeInterval)",
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "VM CPU credits remaining",
      "description": "Burstable VM: near zero = throttled. The alert fires below 30.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${azmon}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${azmon}"
          },
          "queryType": "Azure Monitor",
          "subscription": "${subscription}",
          "azureMonitor": {
            "resources": [
              {
                "subscription": "${subscription}",
                "resourceGroup": "rg-shoplite-prod",
                "resourceName": "prod-sql-01",
                "metricNamespace": "microsoft.compute/virtualmachines",
                "region": "northcentralus"
              }
            ],
            "metricNamespace": "microsoft.compute/virtualmachines",
            "metricName": "CPU Credits Remaining",
            "aggregation": "Average",
            "timeGrain": "auto"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "What SQL Server waited on (seconds per interval, top 6)",
      "description": "",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${adx}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${adx}"
          },
          "database": "shoplite",
          "queryType": "KQL",
          "rawMode": true,
          "query": "let top = SqlWaitStats_CL | where $__timeFilter(TimeGenerated)\n                | summarize Total = sum(WaitTimeMs) by WaitType | top 6 by Total | project WaitType;\n            SqlWaitStats_CL | where $__timeFilter(TimeGenerated) and WaitType in (top)\n            | summarize WaitSeconds = sum(WaitTimeMs) / 1000.0 by bin(TimeGenerated, $__timeInterval), WaitType\n            | order by TimeGenerated asc",
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Failed SQL Agent jobs (last 24 h)",
      "description": "",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${azmon}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${azmon}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "SqlAgentJobRuns_CL | where TimeGenerated > ago(24h) and Outcome == \"failed\"\n            | summarize arg_max(TimeGenerated, JobName, FailedStepName, FailedStepMessage) by HistoryId\n            | project TimeGenerated, JobName, FailedStepName, FailedStepMessage | order by TimeGenerated desc",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "table"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 6
      }
    }
  ]
}
